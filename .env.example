# Copy to .env.local and fill in what you have. Everything is optional:
# with nothing set the app runs on an in-memory store with demo data.

# --- Supabase (persistence) -------------------------------------------------
# Project Settings → API. The service role key is used server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- DataForSEO (live keyword volumes + Google SERPs) -----------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Namecheap (registrar-accurate availability; RDAP is used otherwise) ----
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=false

# --- Your build system ------------------------------------------------------
# Approved opportunities are POSTed here. Without it they queue for pull at
# GET /api/handoffs?status=queued
BUILD_WEBHOOK_URL=
# HMAC-SHA256 of the raw body, sent as  X-Radar-Signature: sha256=<hex>
BUILD_WEBHOOK_SECRET=

# --- Access control for an externally hosted deployment ---------------------
# Basic-auth password for the dashboard (and browser access to /api/*)
RADAR_ADMIN_PASSWORD=
# Bearer token for machine access to /api/*  (Authorization: Bearer <key>)
RADAR_API_KEY=
